+def csv_safe(value: str) -> str:
+    """Neutralize CSV/spreadsheet formula injection. Titles come from scraped
+    page content (attacker-influenced), so a value like '=HYPERLINK(...)' or
+    '@SUM(...)' can execute as a formula when the CSV is opened in Excel/
+    Sheets. Prefix such values with a single-quote escape, the standard
+    mitigation, so they're treated as text."""
+    if value and value[0] in ("=", "+", "-", "@", "\t", "\r"):
+        return "'" + value
+    return value
+
